<Window x:Class="FleetManagement.Wpf.Features.Access.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="410" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#B42318" Visibility="Collapsed"
                       Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" />
                <Button Content="Salvar" IsDefault="True" Click="Save_Click"
                        Background="#175CD3" BorderBrush="#175CD3" Foreground="White" />
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="UsernameLabel" Text="Usuário" FontWeight="SemiBold" />
            <TextBox x:Name="UsernameBox" Margin="0,4,0,14" />
            <TextBlock x:Name="PasswordLabel" Text="Nova senha" FontWeight="SemiBold" />
            <PasswordBox x:Name="PasswordInput" Margin="0,4,0,14" />
            <TextBlock x:Name="RoleLabel" Text="Perfil" FontWeight="SemiBold" />
            <ComboBox x:Name="RoleBox" Margin="0,4,0,14" SelectedIndex="1">
                <ComboBoxItem Content="Administrador" Tag="Administrator" />
                <ComboBoxItem Content="Operador" Tag="Operator" />
                <ComboBoxItem Content="Consulta" Tag="Viewer" />
            </ComboBox>
            <CheckBox x:Name="ActiveBox" Content="Usuário ativo" IsChecked="True" />
        </StackPanel>
    </DockPanel>
</Window>
