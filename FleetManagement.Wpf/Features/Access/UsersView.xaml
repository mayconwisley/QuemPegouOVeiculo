<UserControl x:Class="FleetManagement.Wpf.Features.Access.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource CanvasBrush}">
      <Grid x:Name="ListContent" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Usuários" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="StatusText" Text="Gerencie perfis e senhas de acesso"
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,20,0,14">
            <Button Content="Atualizar" Click="Refresh_Click" />
            <Button Content="Novo usuário" Click="New_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Alterar perfil" Click="Edit_Click" />
            <Button Content="Redefinir senha" Click="Password_Click" />
        </WrapPanel>
        <Grid Grid.Row="2">
            <DataGrid x:Name="UsersGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding [id]}" Width="80" />
                    <DataGridTextColumn Header="Usuário" Binding="{Binding [username]}" Width="*" />
                    <DataGridTextColumn Header="Perfil" Binding="{Binding [role]}" Width="160" />
                    <DataGridTextColumn Header="Ativo" Binding="{Binding [isActive]}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyState" Text="Nenhum usuário encontrado."
                       Style="{StaticResource EmptyStateStyle}" IsHitTestVisible="False" />
        </Grid>
      </Grid>
      <ContentControl x:Name="EditorHost" Visibility="Collapsed" />
    </Grid>
</UserControl>
