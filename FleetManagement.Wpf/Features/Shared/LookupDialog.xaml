<Window x:Class="FleetManagement.Wpf.Features.Shared.LookupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18" Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Buscar" DockPanel.Dock="Right" Click="Search_Click" />
            <TextBox x:Name="SearchBox" KeyDown="Search_KeyDown"
                     ToolTip="Digite nome, placa ou modelo" />
        </DockPanel>
        <DataGrid x:Name="OptionsGrid" Grid.Row="1"
                  MouseDoubleClick="Options_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                <DataGridTextColumn Header="Nome / placa" Binding="{Binding Label}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Anterior" Click="Previous_Click" />
                <Button Content="Próxima" Click="Next_Click" />
                <Button Content="Selecionar" Click="Select_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" />
        </DockPanel>
    </Grid>
</Window>
