<Window x:Class="FleetManagement.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Frota" Width="1380" Height="860"
        MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="5,4,0,20">
                    <TextBlock Text="FROTA" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                    <TextBlock Text="Gestão operacional" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource SidebarMutedBrush}" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel" />
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource SidebarBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="4,16,0,0" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="UserText" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                        <TextBlock x:Name="RoleText" FontSize="12" Margin="0,3,0,13"
                                   Foreground="{DynamicResource SidebarMutedBrush}" />
                        <Button Content="Sair da conta" Style="{StaticResource SidebarExitButtonStyle}"
                                Click="Exit_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SectionText" Text="Painel" FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Gestão de Frota" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Aparência" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox x:Name="ThemeSelector" Width="138"
                                  ToolTip="Escolha como o aplicativo acompanha o tema do Windows"
                                  SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="Automático" Tag="Automatic" />
                            <ComboBoxItem Content="Claro" Tag="Light" />
                            <ComboBoxItem Content="Escuro" Tag="Dark" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="MainContent" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
