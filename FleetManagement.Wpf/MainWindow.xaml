<Window x:Class="FleetManagement.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Frota" Width="1340" Height="830"
        MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#17243A">
            <DockPanel Margin="16,24">
                <StackPanel DockPanel.Dock="Bottom" Margin="2,18,0,0">
                    <TextBlock x:Name="UserText" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock x:Name="RoleText" Foreground="#A8B6CC" Margin="0,3,0,14" />
                    <Button Content="Sair" Click="Exit_Click" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavigationPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <ContentControl x:Name="MainContent" Grid.Column="1" />
    </Grid>
</Window>
