<Window x:Class="FleetManagement.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acessar · Gestão de Frota" Width="450" Height="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid Margin="28">
            <Border Style="{StaticResource CardStyle}" Padding="28" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="FROTA" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Boas-vindas" Style="{StaticResource PageTitleStyle}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Entre para acessar a gestão da frota"
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,23" />
                    <TextBlock Text="Usuário" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,9" />
                    <TextBlock Text="Senha" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,23" />
                    <Button x:Name="EnterButton" Content="Entrar" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                            Click="Enter_Click" />
                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"
                               Margin="0,14,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
